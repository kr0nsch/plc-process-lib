// Назначение: константы демонстрационного прогона (tools/demo): размеры журналов, периоды
//             записи и длительности трёх сценариев. Демо не входит в библиотеку и в тесты: это
//             приложение на установленной plc-process-lib 1.0.0.0, данные которого идут в графики
//             раздела «Как это выглядит» README.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   tools/demo/README.md
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    NS_PER_S          : LREAL := 1.0E9;   // наносекунд в секунде (LTIME)
    // A: контур уровня AI -> ПИД -> ПЧ
    LOOP_LOG_N        : UINT := 800;      // отсчётов журнала (160 с по 0,2 с)
    LOOP_LOG_PERIOD_S : LREAL := 0.2;     // период записи, с
    LOOP_DURATION_S   : LREAL := 150.0;   // длительность сценария, с
    // B: классификация тока по NE 43
    NE43_LOG_N        : UINT := 640;      // отсчётов журнала (64 с по 0,1 с)
    NE43_LOG_PERIOD_S : LREAL := 0.1;     // период записи, с
    NE43_DURATION_S   : LREAL := 58.0;    // длительность сценария, с
    // C: состояния тревоги ISA-18.2
    ALM_LOG_N         : UINT := 520;      // отсчётов журнала (104 с по 0,2 с)
    ALM_LOG_PERIOD_S  : LREAL := 0.2;     // период записи, с
    ALM_DURATION_S    : LREAL := 100.0;   // длительность сценария, с
    // события сценариев (действия «оператора» и возмущения) для подписей на графиках
    EVENT_LOG_N       : UINT := 32;       // записей журнала событий
END_VAR
