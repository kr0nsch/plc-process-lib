// Назначение: значения вне строгих перечислений арматуры для тестов CheckConfig (тип арматуры,
//             положение безопасности, реакция регулирующего клапана на отказ, приоритет тревоги
//             слота). Строгое перечисление
//             не даёт присвоить число в исходном тексте (C0358), а в памяти persistent оно может быть
//             любым: тест пишет iValue и читает поле перечисления. Только для тестов.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/fb/FB_Valve.md
{attribute 'qualified_only'}
TYPE U_TestValveEnum :
UNION
    iValue       : INT;               // число, которое пишет тест
    eType        : E_ValveType;       // то же как тип арматуры
    eSafePos     : E_ValveSafePos;    // то же как положение безопасности
    eFaultAction : E_CvFaultAction;   // то же как реакция регулирующего клапана на отказ
    ePriority    : E_AlarmPriority;   // то же как приоритет тревоги
END_UNION
END_TYPE
