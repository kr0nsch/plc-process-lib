// Назначение: значение вне строгого перечисления для тестов санитизации. Строгое перечисление не
//             даёт присвоить число в исходном тексте (C0358), а в памяти persistent оно может быть
//             любым: тест пишет iValue и читает поле перечисления. Только для тестов.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/TESTING.md, раздел «Тестовое устройство»
{attribute 'qualified_only'}
TYPE U_TestEnumInt :
UNION
    iValue    : INT;               // число, которое пишет тест
    eMode     : E_DeviceMode;      // то же как режим
    ePriority : E_AlarmPriority;   // то же как приоритет тревоги
END_UNION
END_TYPE
