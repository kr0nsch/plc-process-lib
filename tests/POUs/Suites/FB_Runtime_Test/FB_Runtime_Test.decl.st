// Назначение: набор зондов времени выполнения — вопросы раздела 24.2 контракта и ограничения
//             раздела 2.8, которые решает тест на CODESYS Control Win V3 (32 бит): монотонность и
//             разрешение LTIME() (по циклам задачи и внутри цикла), связывание вызова метода без
//             THIS^, частичный инициализатор массива структур, беззнаковая арифметика LTIME и
//             счётчиков, локальные экземпляры устройств в методе теста, цена копирования LKG.
//             Тест Runtime_LTime_MonotonicAcrossTaskCycles идёт 50 циклов задачи: его состояние —
//             в переменных набора (локальные переменные метода создаются заново каждый вызов).
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/TESTING.md, раздел «Зонды времени выполнения»
FUNCTION_BLOCK FB_Runtime_Test EXTENDS coUnit.FB_TestSuite
VAR CONSTANT
    RT_SAMPLES : UINT := 50;                       // циклов задачи в тесте по циклам
END_VAR
VAR
    fbRtSysTime : FB_SystemTime;                  // системное время для теста по циклам
    uiRtCount   : UINT;                           // записано отметок
    altRtStamp  : ARRAY[0..RT_SAMPLES - 1] OF LTIME;   // LTIME() в каждом цикле задачи
END_VAR
