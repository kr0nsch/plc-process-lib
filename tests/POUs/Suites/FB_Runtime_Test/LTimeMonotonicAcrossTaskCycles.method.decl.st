// R1 контракта по циклам задачи: LTIME() (FB_SystemTime) в 50 циклах TestTask (10 мс) строго
// растёт от цикла к циклу, а промежуток 49 циклов — от 49·5 мс до 49·50 мс (время идёт с реальной
// скоростью). Единственный тест библиотеки на несколько циклов: реального ожидания в нём нет,
// цикл задачи — данность. Смену системного времени ОС тест не делает (нужны права администратора).
METHOD PRIVATE LTimeMonotonicAcrossTaskCycles
VAR
    uiIdx    : UINT;            // номер отметки
    xStrict  : BOOL := TRUE;    // каждая следующая отметка больше предыдущей
    ltSpan   : LTIME;           // от первой до последней отметки
END_VAR
