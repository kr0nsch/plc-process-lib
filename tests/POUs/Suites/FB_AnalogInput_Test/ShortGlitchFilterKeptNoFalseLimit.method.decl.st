// Короткий провал сигнала (один вызов с отказом канала, ошибка обмена Modbus): отказ не подтверждён, значение
// удерживается, фильтр заморожен и после провала продолжает с прежнего состояния (AI-12). Фильтр 10 с,
// ступень 50 -> 75, HH 70 без задержки: до провала (1 с) 52,379, через вызов после провала 52,604, HH нет.
// Сброс фильтра выдал бы мгновенное 75 и ложный HH. источник: tools/reference/ai_reference.py, сценарии filter
// «ступень 50 -> 75, T = 10 с, 1 с до провала» и «… провал 0,1 с, фильтр заморожен».
METHOD PRIVATE ShortGlitchFilterKeptNoFalseLimit
VAR
    fbTime  : FB_FakeTime;         // подменное время
    fbAi    : FB_AnalogInput;      // ФБ под тестом
    stCmd   : ST_AnalogInputCmd;   // команды
    stCfg   : ST_AnalogInputCfg;   // конфигурация
    iStep   : INT;                 // шаг цикла
    xEverHH : BOOL;                // HH взводился хотя бы раз
END_VAR
