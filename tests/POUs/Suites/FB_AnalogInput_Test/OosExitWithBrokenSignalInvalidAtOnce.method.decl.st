// Выход из OutOfService с уже оборванной линией (датчик меняли «в ремонте», линию ещё не подключили):
// последнее хорошее значение — до вывода из работы, его возраст неизвестен. Удерживать его как годное
// на время подтверждения нельзя: значение сразу негодно, уставки по нему не считаются (как AI-2 при
// старте ПЛК), отказ — через tFailDelay. Шкала 0..5 м: 17,6 мА = 4,25 м (H 4,0), 16 мА = 3,75 м.
METHOD PRIVATE OosExitWithBrokenSignalInvalidAtOnce
VAR
    fbTime : FB_FakeTime;         // подменное время
    fbAi   : FB_AnalogInput;      // ФБ под тестом
    stCmd  : ST_AnalogInputCmd;   // команды
    stCfg  : ST_AnalogInputCfg;   // конфигурация
    iStep  : INT;                 // шаг цикла
END_VAR
