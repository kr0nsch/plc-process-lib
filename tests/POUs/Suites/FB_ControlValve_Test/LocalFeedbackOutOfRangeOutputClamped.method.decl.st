// Local: выход следует ОС, но только в пределах хода 0…100 %. Датчик положения на закрытом клапане
// показывает чуть ниже нуля (-1,5 %, сигнал ещё достоверен): выход 0 % и 4,0 мА, а не 3,76 мА — ток ниже
// 4 мА позиционер с питанием от токовой петли может не держать (минимальный ток — по паспорту
// позиционера). ОС 102,5 % — выход 100 % и 20,0 мА, а не 20,4 мА. С инверсией: 100 % — 4,0 мА, -1,5 % —
// 20,0 мА. Возврат в Manual — без рывка от ограниченного выхода.
METHOD PRIVATE LocalFeedbackOutOfRangeOutputClamped
VAR
    fbTime   : FB_FakeTime;          // подменное время, старт 1 ч
    fbCv     : FB_ControlValve;      // клапан под тестом
    stCmd    : ST_ControlValveCmd;   // команды HMI
    stRetain : ST_DeviceRetain;      // режим Manual по умолчанию
    stCfg    : ST_ControlValveCfg;   // конфигурация (умолчания: 0…100 %, без рампы)
END_VAR
