// Motorized: ход на открытие дошёл до ZSO на t1 (выход «открывать» снят), сразу команда «закрыть»:
// выход «закрывать» не включается, пока от снятия «открывать» не прошла пауза tReverse = 1 с (на
// t1 + 0,9 с — ещё нет), ровно на t1 + 1,0 с — Closing. То же после стопа в ходе на закрытие (t2) и
// команды «открыть» через 0,2 с: «открывать» включается только на t2 + 1,0 с. Двигатель на выбеге
// встречным включением не реверсируется, даже если ход перед этим остановил концевик или стоп.
METHOD PRIVATE ReverseAfterEndStopWaitsReversePause
VAR
    fbTime   : FB_FakeTime;       // подменное время, старт 1 ч
    fbVlv    : FB_Valve;          // арматура под тестом
    stCmd    : ST_ValveCmd;       // команды HMI
    stRetain : ST_DeviceRetain;   // режим Manual по умолчанию, счётчики
    stCfg    : ST_ValveCfg;       // конфигурация (умолчания: Motorized, ZSO и ZSC, tReverse = 1 с)
    iStep    : INT;               // шаг цикла
    xEverOn  : BOOL;              // выход включался во время паузы
END_VAR
