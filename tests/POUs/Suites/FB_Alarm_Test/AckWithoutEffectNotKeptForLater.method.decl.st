// Квитирование без эффекта не запоминается: Ack в Normal и в Shelved выполняется ближайшим вызовом
// тела и снимается. Следующее появление тревоги (в том числе повторное оповещение после снятия
// shelve) остаётся ActiveUnack и в следующих вызовах — «заранее квитировать» тревогу нельзя
// (ISA-18.2: оператор должен увидеть каждое новое появление)
METHOD PRIVATE AckWithoutEffectNotKeptForLater
VAR
    fbTime : FB_FakeTime;    // подменное время
    fbAlm  : FB_Alarm;       // ФБ под тестом
    stCfg  : ST_AlarmCfg;    // параметры по умолчанию
END_VAR
