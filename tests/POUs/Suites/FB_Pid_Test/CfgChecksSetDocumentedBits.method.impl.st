coUnit.TEST('Pid_CfgChecks_SetDocumentedBits');
uBad.iValue := 7;
uBits.dwValue := 16#7FC00000;
stCfg := stCfgDef;
stCfg.eAction := uBad.eAction;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_ACTION, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 0');
stCfg := stCfgDef;
stCfg.rKp := uBits.rValue;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_KP, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 1: NaN');
AssertTrue(Condition := F_IsFinite(rIn := fbPid.rOut_pct), Message := 'NaN Kp: output finite');
stCfg := stCfgDef;
stCfg.rTd_s := -1.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_TI_TD, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 2');
stCfg := stCfgDef;
stCfg.rTd_s := 1.0;
stCfg.rDFilterN := 1.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_DFILTER, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 3');
stCfg := stCfgDef;
stCfg.rTt_s := -1.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_TT, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 4');
stCfg := stCfgDef;
stCfg.rPvMin_eu := 100.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_PV_RANGE, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 5');
stCfg := stCfgDef;
stCfg.rSpMin_eu := 60.0;
stCfg.rSpMax_eu := 50.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_SP_RANGE, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 6');
stCfg := stCfgDef;
stCfg.rOutMax_pct := 101.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_OUT_RANGE, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 7');
stCfg := stCfgDef;
stCfg.rDeadband_pct := 10.5;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_DEADBAND, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 8');
stCfg := stCfgDef;
stCfg.rOutRate_pctps := -1.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_RATES, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 9');
stCfg := stCfgDef;
stCfg.tSample := T#2S;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_SAMPLE, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 10');
stCfg := stCfgDef;
stCfg.ePvFailAction := uBad.ePvFail;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_PV_FAIL, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 11');
stCfg := stCfgDef;
stCfg.rSafeOut_pct := 120.0;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_PV_FAIL, Actual := fbPid.stSts.stCommon.wCfgErr,
                  Message := 'bit 11: safe output outside output limits');
stCfg := stCfgDef;
stSlot := stCfg.astAlarm[0];
stSlot.ePriority := uBad.ePriority;
stCfg.astAlarm[0] := stSlot;
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfg);
AssertEquals_WORD(Expected := GVL_Const.PID_CFG_ALARM, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'bit 12');
fbPid(itfTime := fbTime, stCmd := stCmd, stRetain := stRetain, stCfg := stCfgDef);
AssertEquals_WORD(Expected := 0, Actual := fbPid.stSts.stCommon.wCfgErr, Message := 'default Cfg: no bits');
coUnit.TEST_FINISHED();
