// Постоянная слежения меньше шага (Tt = 0,05 с, dt = 0,1 с): множитель обратного расчёта
// MIN(dt/Tt, 1) = 1, и за один шаг насыщения интегратор садится ровно на v = u (I = 1 %), выход
// остаётся на пределе. Без MIN множитель был бы 2: I = -49 %, и на следующем шаге выход упал бы с
// предела до 51 % при той же ошибке +50 % — колебание обратного расчёта.
METHOD PRIVATE AntiWindupTtBelowDtGainClampedToOne
VAR
    fbTime   : FB_FakeTime;       // подменное время, старт 1 ч
    fbPid    : FB_PID;            // ФБ под тестом
    stCmd    : ST_PidCmd;         // команды
    stRetain : ST_DeviceRetain;   // режим: старт в Manual
    stCfg    : ST_PidCfg;         // конфигурация теста
    iStep    : INT;               // шаг цикла
    rOutSat  : REAL;              // выход в первом шаге насыщения
    rISat    : REAL;              // интегратор в первом шаге насыщения
    rOutNext : REAL;              // выход в следующем шаге
    rINext   : REAL;              // интегратор в следующем шаге
END_VAR
