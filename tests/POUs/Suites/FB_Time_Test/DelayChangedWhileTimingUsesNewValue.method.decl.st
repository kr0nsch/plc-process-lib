// Изменение задержки во время отсчёта действует сразу: прошедшее время сравнивается с новым
// значением. Уменьшение 10 с → 1 с через 1,5 с — выход в том же вызове; увеличение 2 с → 5 с
// через 1,5 с — выхода нет в 2,0 с и 4,9 с, есть в 5,0 с.
METHOD PRIVATE DelayChangedWhileTimingUsesNewValue
VAR
    fbTime  : FB_FakeTime;   // подменное время, старт 1 ч
    fbShorter : FB_Delay;    // задержку уменьшают
    fbLonger  : FB_Delay;    // задержку увеличивают
    iStep   : INT;           // шаг цикла
END_VAR
